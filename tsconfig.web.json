{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/**/*",
    "src/preload/index.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@type": ["./src/shared/type.ts"],
      "@shared/*": ["./src/shared/*"],
      "@resources/*": ["./resources/*"]
    }
  }
}
