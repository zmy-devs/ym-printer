{
  "name": "ym-printer",
  "productName": "Ym Printer",
  "version": "3.7.1",
  "description": "A desktop application for inkjet printer document preview and printing",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Mingyang Zhang",
    "email": "2514765066@qq.com",
    "url": "https://github.com/zmy-devs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zmy-devs/ym-printer.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "chcp 65001 && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && pnpm run rebuild",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win ",
    "release": "tsx ./scripts/publish.ts",
    "rebuild": "electron-rebuild -f -w winax",
    "format": "prettier . --write"
  },
  "dependencies": {
    "winax": "^3.6.9"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.2.0",
    "@lucide/vue": "^1.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vee-validate/zod": "^4.15.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "nanoid": "^6.0.1",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^4.0.2",
    "plugin-electron-ipc": "^0.1.2",
    "prettier": "^3.9.6",
    "reka-ui": "^2.10.3",
    "sass": "^1.102.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "vee-validate": "^4.15.1",
    "vite": "^8.2.1",
    "vue": "^3.5.41",
    "vue-draggable-plus": "^0.6.1",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.9",
    "ym-release": "^2.0.0",
    "zod": "^4.4.3"
  },
  "volta": {
    "node": "24.18.1",
    "pnpm": "11.20.0"
  }
}
